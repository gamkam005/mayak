<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.mayak.app" android:versionCode="7" android:versionName="0.3.4">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- выбор приложений «мимо VPN»: нужен полный список установленных (APK ставится не из Play) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <!-- самообновление: скачанный с GitHub APK ставит системный установщик (с подтверждением) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <application android:label="МАЯК" android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true" android:extractNativeLibs="true"
        android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="mayak"/>
            </intent-filter>
        </activity>
        <service android:name=".MayakService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local proxy that keeps the encrypted tunnel running"/>
        </service>
        <service android:name=".MayakVpn" android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter><action android:name="android.net.VpnService"/></intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN: routes device traffic through a local anti-censorship proxy"/>
        </service>
        <provider android:name=".ApkProvider" android:authorities="ru.mayak.app.apk"
            android:exported="false" android:grantUriPermissions="true"/>
    </application>
</manifest>
